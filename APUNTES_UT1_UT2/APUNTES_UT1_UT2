 QUE HACE CADA METODO (y en que paquetes esta)
---------------------------------------------------------------------
 LEER (devuelven List<Pokemon>)
   leerTXT(fichero)            c01 c02 c03
       BufferedReader + readLine + split(SEPARADOR) -> new Pokemon
   leerDAT(fichero)            c04 c05 c06
       ObjectInputStream + readObject -> la lista entera de golpe
       + crearDATdePrueba(fichero): crea el .dat de ejemplo si no existe
   leerXML(fichero)            c07 c08 c09 c10
       parse + getElementsByTagName(ETIQUETA_POKEMON) + for con item(i)
       + textoDe(elemento, etiqueta): saca el texto de <etiqueta>
   leerJSON(fichero)           c11 c12 c13 c14
       gson.fromJson(lector, Pokedex.class).getPokemons()
   leerBBDD(conexion)          c15 c16 c17 c18
       SELECT numero_pokedex, nombre, peso FROM pokemon + while(next)

 ESCRIBIR (reciben List<Pokemon>)
   escribirTXT(lista, fichero)      c08 c12 c17
       BufferedWriter + write("codigo, nombre, peso") + newLine
   escribirDAT(lista, fichero)      c09 c13 c18
       ObjectOutputStream + writeObject(lista)
   escribirXML(lista, fichero)      c01 c04 c11 c15
       newDocument + raiz + un <pokemon> por objeto
       + anyadirHijo(doc, padre, etiqueta, texto): createElement + setTextContent + appendChild
       + grabarXML(doc, fichero): Transformer, guarda en disco
   escribirJSON(lista, fichero)     c02 c05 c07 c16
       new Pokedex(lista) + gson.toJson(pokedex, escritor)
   escribirBBDD(conexion, lista)    c03 c06 c10 c14
       INSERT INTO pokemon (...) VALUES (?, ?, ?, ?) + executeUpdate
       + existePokemon(conexion, codigo): SELECT ... WHERE numero_pokedex = ?
         (si ya existe NO se inserta)

